<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppParcialesMauiTrapiella.Views.AgregarPacientePage"
             Title="Agregar Paciente">

    <VerticalStackLayout Padding="20" Spacing="12"
                         BackgroundColor="#A1E3AD">

        <Entry Placeholder="Nombre" Text="{Binding Nombre}"
               PlaceholderColor="Black"
               TextColor="Black"
               FontSize="16"/>
        
        <Entry Placeholder="Especie" Text="{Binding Especie}"
               PlaceholderColor="Black"
               TextColor="Black"
               FontSize="16"/>
        
        <Entry Placeholder="Raza" Text="{Binding Raza}"
               PlaceholderColor="Black"
               TextColor="Black"
               FontSize="16"/>

        <Button Text="Guardar"

                Command="{Binding GuardarCommand}"/>

        <Button Text="Cancelar"
                BackgroundColor="Red"
                FontAttributes="Bold"
                FontSize="16"
                TextColor="Black"
                Command="{Binding CancelarCommand}"/>

        <Label Text="{Binding Mensaje}" TextColor="Red"/>
    </VerticalStackLayout>
</ContentPage>
