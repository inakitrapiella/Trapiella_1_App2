<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppParcialesMauiTrapiella.MainPage"
             xmlns:vm="clr-namespace:AppParcialesMauiTrapiella.ViewsModels"
             Title="Veterinaria - Ingreso">

    <ContentPage.BindingContext>
        <vm:MainPageViewModels />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Inicio de sesión" FontSize="22" HorizontalOptions="Center"/>

        <Entry Placeholder="Usuario"
               Text="{Binding Username}" />

        <Entry Placeholder="Contraseña"
               IsPassword="True"
               Text="{Binding Password}" />

        <Button Text="Ingresar"
                Command="{Binding LoginCommand}" />

        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
        <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}" />
    </VerticalStackLayout>
</ContentPage>