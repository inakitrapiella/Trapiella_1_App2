<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppParcialesMauiTrapiella.Views.PacientePage"
             xmlns:vm="clr-namespace:AppParcialesMauiTrapiella.ViewsModels"
             Title="PacientePage">

    <VerticalStackLayout Padding="20" Spacing="10"
                         BackgroundColor="#A1E3AD">

        <Button Text="Agregar paciente"
                BackgroundColor="#54785B"
                FontAttributes="Bold"
                FontSize="16"
                Command="{Binding AgregarCommand}"/>

        <Button Text="Cargar" Command="{Binding CargarCommand}"
            BackgroundColor="bLUE"
            FontAttributes="Bold"
            FontSize="16"
            />
        
        <ActivityIndicator IsRunning="{Binding Cargando}" IsVisible="{Binding Cargando}"/>
        <Label Text="{Binding Estado}" TextColor="Black"/>

        <CollectionView ItemsSource="{Binding Mascotas}" 
                        SelectionMode="None"
                        BackgroundColor="White">
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                        <Label Text="{Binding Nombre}" FontAttributes="Bold" VerticalOptions="Center" />

                        <Button Grid.Column="1" Text="Detalle"
                                BackgroundColor="LightGreen"
                                FontAttributes="Bold"
                                TextColor="Black"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeleccionarCommand}"
                                CommandParameter="{Binding .}"/>

                        <Button Grid.Column="3" Text="Eliminar"
                                TextColor="Black"
                                FontAttributes="Bold"
                                BackgroundColor="Red"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarCommand}"
                                CommandParameter="{Binding .}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
